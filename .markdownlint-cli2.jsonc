{
  // MD013 (line length) is off because .editorconfig already declares the limit
  // (max_line_length = 100). MD013 would be a second home for it, at a different number.
  // MD060 (table pipe style) flags the standard unpadded separator row (|---|---|) as
  // inconsistent with padded header/data rows in every GFM table.
  "config": {
    "default": true,
    "MD013": false,
    "MD060": false
  },
  // A PR template opens on a section heading, not an H1 — GitHub renders its body inside the PR.
  // Scoped to that file rather than disabled project-wide.
  "overrides": [
    {
      "filter": [".github/PULL_REQUEST_TEMPLATE.md"],
      "config": { "MD041": false },
      "combine": "merge"
    },
    // These two are prompt fragments concatenated around a milestone's PROMPT.md, not documents.
    // They open on a section heading because that is where they land in the assembled prompt; an
    // H1 would put a stray title in the middle of it.
    {
      "filter": ["scaffold/milestones/agent-rules-*.md"],
      "config": { "MD041": false },
      "combine": "merge"
    }
  ]
}
